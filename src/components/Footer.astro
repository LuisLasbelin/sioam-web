		<img src={"https://pub-0b436f949b31421fb72eff5540589489.r2.dev/Dipu_negativo_solo.png"} alt={"Diputació de València"} width={200} class="logo"/>
		<img src={"https://pub-0b436f949b31421fb72eff5540589489.r2.dev/gv_distintiu_horitzontal_blanc_val.png"} alt={"Generalitat Valenciana"} width={200} class="logo"/>
	</div>
</footer>
<style>
	footer {
		margin-top: 2em;
		padding: 2em 1em 6em 1em;
		background: rgb(var(--black));
		color: rgb(var(--gray));
		text-align: center;
	}
	.logos {
		display: flex;
		justify-content: center;
