---
import Image from "astro/components/Image.astro";
import diputacio from "../assets/Dipu_negativo_solo.png"
import gva from "../assets/gv_distintiu_horitzontal_blanc_val.png"

const today = new Date();
---

<footer>
	&copy; {today.getFullYear()} SIOAM.
	<div class="logos">
		<Image src={diputacio} alt={"Diputació de València"} width={200} class="logo"/>
		<Image src={gva} alt={"Generalitat Valenciana"} width={200} class="logo"/>
	</div>
</footer>
<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: rgb(var(--black));
		color: rgb(var(--gray));
		text-align: center;
	}
	.logos {
		display: flex;
		justify-content: center;
		gap: 1em;
		margin-top: 1em;
		align-items: center;
	}
	.logo {
		height: fit-content;
	}
</style>
