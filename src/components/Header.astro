---
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";
import seal from "../assets/sello-sioam.png";
import Image from "astro/components/Image.astro";
---

<header>
  <nav>
    <div class="title-logo">
      <a class="title-box" href="/">
        <Image width={64} height={64} src={seal} alt="Logo de la SIOAM" />
        <div class="title-text">
          <h2 class="title">{SITE_TITLE}</h2>
          <h3 class="subtitle">{SITE_DESCRIPTION}</h3>
        </div>
      </a>
    </div>
    <div class="internal-links">
      <HeaderLink href="/">Inicio</HeaderLink>
      <HeaderLink href="/noticias">Noticias</HeaderLink>
      <HeaderLink href="/sociedad">Sociedad</HeaderLink>
      <HeaderLink href="/escuela">Escuela</HeaderLink>
      <HeaderLink href="/banda">Banda</HeaderLink>
      <HeaderLink href="/banda-juvenil">B.Juvenil</HeaderLink>
      <HeaderLink href="/orquesta">Orquesta</HeaderLink>
      <HeaderLink href="/contacto">Contacto</HeaderLink>
    </div>
  </nav>
</header>
<style>
  header {
    margin: 0;
    padding: 0 1em;
    background: white;
    box-shadow: 0 2px 8px rgba(var(--black), 5%);
  }
  h2 {
    margin: 0;
    font-size: 1em;
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: space-around;
    margin: 0 2em 0 2em;
  }
  nav .internal-links a {
    padding: 1em 0.5em;
    color: var(--black);
    border-bottom: 4px solid transparent;
    text-decoration: none;
    &.active {
      text-decoration: none;
      margin-bottom: solid 1px var(--accent);
      border-bottom-color: var(--accent);
    }
  }

  .internal-links {
    flex: 2;
    display: flex;
    justify-content: end;
    gap: 1em;
  }

  .title-logo {
    flex: 1;
  }

  .title-box {
    display: flex;
    flex-direction: row;
    max-height: 64px;
    padding: 0;
    text-decoration: none;
  }

  .title-text {
    display: flex;
    flex-direction: column;
    justify-content: end;
    gap: 4px;
  }

  .title {
    padding: 0;
  }

  .subtitle {
    padding: 0;
    font-size: small;
    font-weight: 100;
  }
</style>
